# --- GitHub Configuration ---
# Your GitHub username in lowercase (e.g., "johndoe")
GITHUB_REPOSITORY_OWNER=

# --- Database Configuration ---
DB_HOST=
DB_PORT=3306
DB_NAME=agent_db
DB_USERNAME=root
DB_PASSWORD=

# --- Redis Configuration ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Security ---
# Secret key for JWT signing
JWT_SECRET=
# Internal token for backend-to-agent communication
INTERNAL_API_TOKEN=

# --- AI / LLM Configuration ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# --- Storage / MinIO Configuration ---
OSS_ACCESS_KEY=admin
OSS_SECRET_KEY=
# Format: http://your-server-ip/oss
OSS_PUBLIC_BASE_URL=
OSS_SECURE=false
OSS_AUTO_CREATE_BUCKETS=true
OSS_BUCKET_AVATAR=avatar
OSS_BUCKET_DOCUMENT=document

# --- Application Info ---
APP_NAME="Job Agent"
APP_VERSION=1.0.0
DEBUG=false
